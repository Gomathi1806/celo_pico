# Network: "celo" (mainnet) or "celo-alfajores" (testnet)
X402_NETWORK=celo-alfajores
NEXT_PUBLIC_X402_NETWORK=celo-alfajores

# Your operator wallet — receives cUSD/USDC payments via thirdweb x402 facilitator
OPERATOR_WALLET_ADDRESS=0xYourMiniPayAddress

# Thirdweb keys — get free at thirdweb.com/dashboard → Settings → API Keys
# secretKey = server-side only (NEVER expose to client)
# clientId  = safe to expose to browser
THIRDWEB_SECRET_KEY=sk_your_thirdweb_secret_key
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# App URL — leave unset on Vercel (auto-detected from VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — rate limiting (provision via console.upstash.com or Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_SPEND_CAP_USD=2.0
