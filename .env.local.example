# Network: "celo" (mainnet) or "celo-alfajores" (testnet)
X402_NETWORK=celo-alfajores
NEXT_PUBLIC_X402_NETWORK=celo-alfajores

# Your operator wallet — receives stablecoin payments.
# Set BOTH: server uses OPERATOR_WALLET_ADDRESS to verify, client uses
# NEXT_PUBLIC_OPERATOR_ADDRESS as the transfer recipient in MiniPay.
OPERATOR_WALLET_ADDRESS=0xYourMiniPayAddress
NEXT_PUBLIC_OPERATOR_ADDRESS=0xYourMiniPayAddress

# Thirdweb keys — get free at thirdweb.com/dashboard → Settings → API Keys
# secretKey = server-side only (NEVER expose to client)
# clientId  = safe to expose to browser
THIRDWEB_SECRET_KEY=sk_your_thirdweb_secret_key
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# AI providers — all optional. If unset, falls back to Pollinations.ai (free).
# Precedence: Groq → Google Gemini → Pollinations for text;
#             Fal (Flux schnell) → Pollinations for images;
#             Firecrawl → LLM-based fallback for scraping.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
FAL_KEY=
FIRECRAWL_API_KEY=

# App URL — leave unset on Vercel (auto-detected from VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — rate limiting (provision via console.upstash.com or Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_SPEND_CAP_USD=2.0
